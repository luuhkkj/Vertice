# ==============================================================================
# Configurações Gerais da Aplicação Vértice
# ==============================================================================
PROJECT_NAME="Vértice Backend API"
VERSION="0.2.1"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ==============================================================================
# CORS (Origens permitidas para requisições cross-origin)
# Pode ser informado como JSON list ou string separada por vírgula.
# ATENÇÃO: Em produção (ENVIRONMENT=production), não é permitido usar ["*"].
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:3000"]

# ==============================================================================
# Banco de Dados PostgreSQL (SQLAlchemy 2 + psycopg 3)
# Preencha as variáveis abaixo ou defina DATABASE_URL diretamente.
# Não há credenciais padrão fixas no código.
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Alternativa: URL completa (sobrescreve os campos individuais se definida)
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/nome_do_banco

# ==============================================================================
# Segurança & JWT (OBRIGATÓRIO)
# Gere uma chave exclusiva com no mínimo 32 caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A aplicação recusará inicializar sem SECRET_KEY válida.
# ==============================================================================
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Criação do Primeiro Administrador (opcional via variáveis para o script CLI)
# ==============================================================================
# ADMIN_NOME=""
# ADMIN_EMAIL=""
# ADMIN_SENHA=""
