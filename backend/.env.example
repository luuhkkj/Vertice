# ==============================================================================
# Configurações Gerais da Aplicação Vértice
# ==============================================================================
PROJECT_NAME="Vértice Backend API"
VERSION="0.2.1"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ==============================================================================
# CORS (Origens permitidas para requisições cross-origin)
# Pode ser informado como JSON list ou string separada por vírgula.
# ATENÇÃO: Em produção (ENVIRONMENT=production), não é permitido usar ["*"].
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:3000"]

# ==============================================================================
# Banco de Dados PostgreSQL (SQLAlchemy 2 + psycopg 3)
# Preencha as variáveis abaixo ou defina DATABASE_URL diretamente.
# Não há credenciais padrão fixas no código.
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Alternativa: URL completa (sobrescreve os campos individuais se definida)
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/nome_do_banco

# ==============================================================================
# Segurança & JWT (OBRIGATÓRIO)
# Gere uma chave exclusiva com no mínimo 32 caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# A aplicação recusará inicializar sem SECRET_KEY válida.
# ==============================================================================
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Assistente IA local (gratuito). Após instalar o Ollama e baixar um modelo,
# altere o provedor para "ollama". Para uso fora do Docker, a URL padrão funciona.
ASSISTENTE_LLM_PROVEDOR=desativado
ASSISTENTE_OLLAMA_BASE_URL=http://127.0.0.1:11434
ASSISTENTE_OLLAMA_MODELO=qwen2.5:3b
ASSISTENTE_OLLAMA_TIMEOUT_SEGUNDOS=180

# ==============================================================================
# Criação do Primeiro Administrador (opcional via variáveis para o script CLI)
# ==============================================================================
# ADMIN_NOME=""
# ADMIN_EMAIL=""
# ADMIN_SENHA=""

# ==============================================================================
# Pipeline Automatizado de Machine Learning (opcional)
# ==============================================================================
# A emissão do token continua exclusivamente manual no perfil Administrador -> Credenciais ML,
# onde escola e modelo autorizado são selecionados diretamente pela interface.
# VERTICE_API_URL=http://127.0.0.1:8000
# VERTICE_ML_SERVICE_TOKEN=vtx_ml_SEU_TOKEN
# VERTICE_ML_SCHEDULER_ENABLED=false
# VERTICE_ML_SCHEDULER_INTERVAL_SECONDS=3600
