# ==============================================================================
# Configurações Gerais da Aplicação Vértice
# ==============================================================================
PROJECT_NAME="Vértice Backend API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ==============================================================================
# CORS (Origens permitidas para requisições cross-origin)
# Pode ser informado como JSON list ou string separada por vírgula.
# Exemplo para desenvolvimento: Frontend Streamlit padrão roda em localhost:8501
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501","http://localhost:3000"]

# ==============================================================================
# Banco de Dados PostgreSQL (SQLAlchemy 2 + psycopg 3)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vertice_db

# Ou defina a URL completa diretamente (opcional, sobrescreve os parâmetros acima):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vertice_db

# ==============================================================================
# Segurança & JWT
# ATENÇÃO: Altere o SECRET_KEY para um segredo forte em produção!
# Gere com: openssl rand -hex 32 ou python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================
SECRET_KEY=change-this-secret-key-in-production-vertice-edu-2026-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

