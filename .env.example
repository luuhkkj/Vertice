# ==============================================================================
# Variáveis de Ambiente para Execução via Docker Compose (Raiz do Projeto)
# Copie este arquivo para `.env` na raiz e defina valores seguros antes de subir.
# ==============================================================================

# Banco PostgreSQL (container `db` — isolado na rede interna por padrão;
# `POSTGRES_EXTERNAL_PORT` só é usada ao ativar `docker-compose.postgres-local.yml`)
POSTGRES_USER=vertice
POSTGRES_PASSWORD=
POSTGRES_DB=vertice
POSTGRES_EXTERNAL_PORT=5432

# Backend FastAPI (containers `migrate` e `backend`)
PROJECT_NAME=Vértice Backend API
VERSION=0.2.1
ENVIRONMENT=production
DEBUG=False
API_V1_STR=/api/v1
BACKEND_PORT=8000

# Origens CORS permitidas (JSON list ou separadas por vírgula; sem '*' em produção)
BACKEND_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Gere uma chave exclusiva com no mínimo 32 caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Streamlit (container `frontend`)
FRONTEND_PORT=8501
VERTICE_API_URL=http://backend:8000/api/v1

# Assistente IA gratuito via Ollama local (opcional).
# Para habilitar no Docker Compose: ASSISTENTE_LLM_PROVEDOR=ollama
# O modelo qwen2.5:3b deve ser baixado uma vez com `docker compose exec ollama ollama pull qwen2.5:3b`.
ASSISTENTE_LLM_PROVEDOR=desativado
ASSISTENTE_OLLAMA_BASE_URL=http://ollama:11434
ASSISTENTE_OLLAMA_MODELO=qwen2.5:3b
ASSISTENTE_OLLAMA_TIMEOUT_SEGUNDOS=180
